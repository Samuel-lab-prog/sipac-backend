{
	"compilerOptions": {
		// Environment setup & latest features
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "Preserve",
		"moduleDetection": "force",
		"jsx": "react-jsx",
		"allowJs": false,
		"baseUrl": ".",
		"ignoreDeprecations": "6.0",
		"types": ["bun", "node"],
		"paths": {
			"@PrismaGenerated/*": [
				"./src/generic-subdomains/persistance/prisma/generated/*"
			],
			"@Domains/*": ["./src/domains/*"],
			"@DomainError": [
				"./src/generic-subdomains/utils/error-handling/domain-error/util.ts"
			],
			"@AppError": [
				"./src/generic-subdomains/utils/error-handling/app-error/util.ts"
			],
			"@PrismaErrorHandler": [
				"./src/generic-subdomains/persistance/utils/prisma-error-handler.ts"
			],
			"@Prisma": [
				"./src/generic-subdomains/persistance/prisma/prisma-client.ts"
			],
			"@GenericSubdomains/*": ["./src/generic-subdomains/*"],
			"@SharedKernel/*": ["./src/shared-kernel/*"],
			"*": ["./src/*"]
		},

		// Bundler mode
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,

		// Best practices
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,

		// Some stricter flags (disabled by default)
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noPropertyAccessFromIndexSignature": false
	},
	"include": [
		"src/**/*.ts",
		"architecture-analysis/**/*.ts",
		"tests/**/*.ts",
		"prisma.config.ts",
		"eslint.config.ts"
	],
	"exclude": ["node_modules", "src/**/generated/**"]
}
