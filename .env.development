NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sipac_dev
JWT_SECRET_KEY=dev-secret-key-change-me
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=dummy-access-key
AWS_SECRET_ACCESS_KEY=dummy-secret-key
S3_BUCKET_NAME=local-dev-bucket
S3_PUBLIC_BASE_URL=http://localhost:9000/local-dev-bucket
S3_SIGNED_URL_EXPIRES_IN=300
SECURITY_HEADERS_ENABLED=true
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_MAX=1000
RATE_LIMIT_DURATION_MS=900000
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_DURATION_MS=900000
RATE_LIMIT_CONTEXT_SIZE=10000
RATE_LIMIT_HEADERS=true
RATE_LIMIT_ERROR_JSON=true
RATE_LIMIT_SKIP_PATHS=/health,/metrics
BODY_LIMIT_BYTES=1000000
MAX_AVATAR_UPLOAD_BYTES=5000000
MAX_POEM_AUDIO_UPLOAD_BYTES=20000000
MAX_ACADEMIC_FILE_UPLOAD_BYTES=25000000
CSRF_ENABLED=false
CROSS_SITE_COOKIES=false
TRUST_PROXY=false
