NODE_ENV=development
PORT=5000
STORAGE_DRIVER=local
LOCAL_STORAGE_PUBLIC_URL=http://localhost:5000/api/v1
LOCAL_STORAGE_DIR=storage/dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agias_dev?schema=public
JWT_SECRET_KEY=change-me-dev-jwt-secret
CROSS_SITE_COOKIES=false
CSRF_ENABLED=false
