generator client {
  provider = "prisma-client"
  output   = "generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  passwordHash String
  name         String
  nickname     String @unique
  bio          String
  avatarUrl    String?

  role   UserRole   @default(author)
  status UserStatus @default(active)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  emailVerifiedAt DateTime?

}

enum UserRole {
  author
  moderator
  admin
}

enum UserStatus {
  active
  banned
  suspended
}
