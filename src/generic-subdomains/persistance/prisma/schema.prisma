generator client {
  provider = "prisma-client"
  output   = "generated"
}

datasource db {
  provider = "postgresql"
}

model User {
	id           Int    @id @default(autoincrement())
	email        String @unique
	passwordHash String
	name         String
	nickname     String @unique
	rg           String @unique
	cpf          String @unique
	avatarUrl    String?

	role   UserRole   @default(student)
	status UserStatus @default(active)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  emailVerifiedAt DateTime?

	studentProfile  StudentProfile?
	professorProfile ProfessorProfile?
	staffProfile     StaffProfile?
	studentRegistration StudentRegistration?
	announcementsCreated Announcement[]
	activitySubmissionComments AcademicActivitySubmissionComment[]
	createdAcademicCalendarEvents AcademicCalendarEvent[] @relation("CreatedAcademicCalendarEvents")

}

model StudentRegistration {
  id          Int      @id @default(autoincrement())
  academicId  String   @unique
  cpf         String   @unique
  userId      Int?     @unique
  activatedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Department {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  code      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  courses   Course[]
  professors ProfessorProfile[] @relation("ProfessorDepartment")
  staff     StaffProfile[]
}

model AcademicPeriod {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  year      Int
  term      Int
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes   ClassOffering[]
  calendarEvents AcademicCalendarEvent[]

  @@unique([year, term])
}

model Course {
  id           Int        @id @default(autoincrement())
  name         String     @unique
  code         String     @unique
  level        String
  departmentId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  students   StudentProfile[] @relation("StudentCourse")
  classes    ClassOffering[]
}

model Announcement {
  id            Int      @id @default(autoincrement())
  title         String
  body          String
  audience      String   @default("all")
  isPinned      Boolean  @default(false)
  publishedAt   DateTime?
  expiresAt     DateTime?
  createdByUserId Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy User @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([audience, publishedAt])
  @@index([createdByUserId, createdAt])
}

model StudentProfile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  academicId    String   @unique
  courseId      Int?
  admissionYear Int?
  status        String   @default("active")
  birthDate     DateTime?
  gender        String?
  genderIdentity String?
  sexualOrientation String?
  race          String?
  nationality   String?
  birthplace    String?
  birthCountry  String?
  maritalStatus String?
  bloodType     String?
  disability    String?
  fatherName    String?
  motherName    String?
  rgIssueDate   DateTime?
  rgIssuer      String?
  rgState       String?
  electoralTitle String?
  electoralZone String?
  electoralSection String?
  militaryCertificate String?
  documentSeries String?
  postalCode    String?
  street       String?
  addressNumber String?
  addressComplement String?
  neighborhood String?
  state        String?
  city         String?
  phone        String?
  mobilePhone  String?
  familyIncomeRange FamilyIncomeRange?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation("StudentCourse", fields: [courseId], references: [id])
  enrollments Enrollment[]
  attendanceRecords AttendanceRecord[]
  activitySubmissions AcademicActivitySubmission[]
}

model ProfessorProfile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  registryCode  String?  @unique
  departmentId  Int?
  title         String?
  workload      Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation("ProfessorDepartment", fields: [departmentId], references: [id])
  teachingAssignments TeachingAssignment[]
  markedAttendanceRecords AttendanceRecord[]
  createdActivities AcademicActivity[]
}

model StaffProfile {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  departmentId Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id])
}

model ClassOffering {
  id          Int      @id @default(autoincrement())
  courseId    Int
  academicPeriodId Int
  shift       Shift
  term        String
  year        Int
  code        String   @unique
  title       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id])
  academicPeriod AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  teachingAssignments TeachingAssignment[]
  sessions ClassSession[]
  activities AcademicActivity[]
  coursePlan CoursePlan?

  @@index([academicPeriodId, shift])
}

model Enrollment {
  id              Int      @id @default(autoincrement())
  studentProfileId Int
  classOfferingId  Int
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  classOffering  ClassOffering   @relation(fields: [classOfferingId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, classOfferingId])
}

model TeachingAssignment {
  id               Int      @id @default(autoincrement())
  professorProfileId Int
  classOfferingId   Int
  role             String   @default("lead")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  professorProfile ProfessorProfile @relation(fields: [professorProfileId], references: [id], onDelete: Cascade)
  classOffering    ClassOffering    @relation(fields: [classOfferingId], references: [id], onDelete: Cascade)

  @@unique([professorProfileId, classOfferingId])
}

model ClassSession {
  id              Int      @id @default(autoincrement())
  classOfferingId Int
  coursePlanTopicId Int?
  startsAt        DateTime
  endsAt          DateTime?
  topic           String?
  status          LessonStatus @default(scheduled)
  deliveredContent String?
  room            String?
  publicNotes     String?
  replacesSessionId Int? @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  classOffering ClassOffering @relation(fields: [classOfferingId], references: [id], onDelete: Cascade)
  attendanceRecords AttendanceRecord[]
  coursePlanTopic CoursePlanTopic? @relation(fields: [coursePlanTopicId], references: [id], onDelete: SetNull)
  replacesSession ClassSession? @relation("LessonReplacement", fields: [replacesSessionId], references: [id], onDelete: SetNull)
  replacementSession ClassSession? @relation("LessonReplacement")
  materials ClassSessionMaterial[]
  activities AcademicActivity[]

  @@index([classOfferingId, startsAt])
  @@index([coursePlanTopicId])
}

model CoursePlan {
  id              Int      @id @default(autoincrement())
  classOfferingId  Int      @unique
  syllabus        String?
  generalObjectives String?
  methodology     String?
  assessmentCriteria String?
  workloadMinutes Int?
  status          CoursePlanStatus @default(draft)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  classOffering ClassOffering @relation(fields: [classOfferingId], references: [id], onDelete: Cascade)
  units CoursePlanUnit[]
}

model CoursePlanUnit {
  id          Int      @id @default(autoincrement())
  coursePlanId Int
  title       String
  description String?
  position    Int
  startsAt    DateTime?
  endsAt      DateTime?
  workloadMinutes Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  coursePlan CoursePlan @relation(fields: [coursePlanId], references: [id], onDelete: Cascade)
  topics CoursePlanTopic[]
  activities AcademicActivity[]
  @@unique([coursePlanId, position])
}

model CoursePlanTopic {
  id          Int      @id @default(autoincrement())
  unitId      Int
  title       String
  description String?
  position    Int
  type        CoursePlanTopicType @default(content)
  estimatedMinutes Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  unit CoursePlanUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  sessions ClassSession[]
  activities AcademicActivity[]
  @@unique([unitId, position])
}

model AttendanceRecord {
  id               Int      @id @default(autoincrement())
  classSessionId    Int
  studentProfileId  Int
  status           String   @default("present")
  markedByProfessorProfileId Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  classSession   ClassSession   @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  markedByProfessor ProfessorProfile? @relation(fields: [markedByProfessorProfileId], references: [id])

  @@unique([classSessionId, studentProfileId])
  @@index([studentProfileId, status])
}

model AcademicActivity {
  id              Int      @id @default(autoincrement())
  classOfferingId Int
  title           String
  description     String?
  dueAt           DateTime?
  allowLateSubmissions Boolean @default(true)
  createdByProfessorProfileId Int?
  kind            AcademicActivityKind @default(activity)
  assessmentType  String?
  appliesAt       DateTime?
  maxGrade        Float?
  weight          Float?
  coursePlanUnitId Int?
  coursePlanTopicId Int?
  classSessionId  Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  classOffering ClassOffering @relation(fields: [classOfferingId], references: [id], onDelete: Cascade)
  createdByProfessor ProfessorProfile? @relation(fields: [createdByProfessorProfileId], references: [id])
  attachments AcademicActivityAttachment[]
  submissions AcademicActivitySubmission[]
  coursePlanUnit CoursePlanUnit? @relation(fields: [coursePlanUnitId], references: [id], onDelete: SetNull)
  coursePlanTopic CoursePlanTopic? @relation(fields: [coursePlanTopicId], references: [id], onDelete: SetNull)
  classSession ClassSession? @relation(fields: [classSessionId], references: [id], onDelete: SetNull)

  @@index([classOfferingId, dueAt])
}

enum LessonStatus {
  scheduled
  completed
  cancelled
  rescheduled
  missed
}

enum AcademicActivityKind {
  activity
  assessment
}

model ClassSessionMaterial {
  id Int @id @default(autoincrement())
  classSessionId Int
  title String
  url String
  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  @@unique([classSessionId, url])
}

model AcademicActivityAttachment {
  id              Int      @id @default(autoincrement())
  activityId      Int
  fileName        String
  fileUrl         String
  fileKey         String
  contentType     String?
  fileSize        Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  activity AcademicActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
}

model AcademicActivitySubmission {
  id              Int      @id @default(autoincrement())
  activityId      Int
  studentProfileId Int
  submittedAt     DateTime?
  grade           Decimal? @db.Decimal(5, 2)
  feedback        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  activity       AcademicActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  studentProfile  StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  attachments     AcademicActivitySubmissionAttachment[]
	comments        AcademicActivitySubmissionComment[]

  @@unique([activityId, studentProfileId])
  @@index([studentProfileId, submittedAt])
}

enum FamilyIncomeRange {
  ATE_0_5_SM
  DE_0_5_A_1_SM
  DE_1_A_2_SM
  DE_2_A_3_SM
  DE_3_A_5_SM
  ACIMA_DE_5_SM
  NAO_DECLARADA
  PREFIRO_NAO_INFORMAR
}

enum CoursePlanStatus {
  draft
  published
  archived
}

enum CoursePlanTopicType {
  content
  review
  activity
  assessment
  project
}

model AcademicCalendarEvent {
  id              Int      @id @default(autoincrement())
  academicPeriodId Int
  type            AcademicCalendarEventType
  title           String
  description     String?
  startsAt        DateTime
  endsAt          DateTime?
  allDay          Boolean  @default(true)
  isInstructionalDay Boolean @default(false)
  createdByUserId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  academicPeriod AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)
  createdBy User? @relation("CreatedAcademicCalendarEvents", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([academicPeriodId, startsAt])
  @@index([type, startsAt])
}

model AcademicActivitySubmissionAttachment {
  id           Int      @id @default(autoincrement())
  submissionId Int
  fileName     String
  fileUrl      String
  fileKey      String
  contentType  String?
  fileSize     Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submission AcademicActivitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model AcademicActivitySubmissionComment {
  id           Int      @id @default(autoincrement())
  submissionId Int
  authorUserId Int
  body         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submission AcademicActivitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  author     User @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
  @@index([authorUserId, createdAt])
}

enum UserRole {
  student
  professor
  staff
  admin
}

enum UserStatus {
  active
  pending
  blocked
  suspended
}

enum Shift {
  morning
  afternoon
  evening
  integral
}

enum AcademicCalendarEventType {
  holiday
  academic_event
  instructional_saturday
  exam
  break
}
