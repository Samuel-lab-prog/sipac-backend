generator client {
  provider = "prisma-client"
  output   = "generated"
}

datasource db {
  provider = "postgresql"
}

model User {
	id           Int    @id @default(autoincrement())
	email        String @unique
	passwordHash String
	name         String
	nickname     String @unique
	rg           String @unique
	cpf          String @unique
	avatarUrl    String?
	academicId   String? @unique
	campus       String?
	department   String?
	course       String?
	admissionYear Int?

	role   UserRole   @default(student)
	status UserStatus @default(active)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  emailVerifiedAt DateTime?

}

enum UserRole {
  student
  professor
  staff
  admin
}

enum UserStatus {
  active
  blocked
  suspended
}
